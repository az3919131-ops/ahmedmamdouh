# ───────── ELTEZAM — environment variables ─────────
# Copy to .env.local for local dev. On Netlify: Site settings → Environment variables.
# NEVER commit real values. VITE_* values are PUBLIC (bundled into the browser) — no secrets there.

# Public (browser) — Supabase project URL + anon (publishable) key. Leave empty to run in local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=

# Server only (Netlify Functions)
SUPABASE_URL=                 # same as VITE_SUPABASE_URL (optional if VITE_SUPABASE_URL is set)
SUPABASE_SERVICE_ROLE_KEY=    # used ONLY inside netlify/functions to verify usage limits
ANTHROPIC_API_KEY=            # enables AI (CV assistant, content, video scripts, storyboard)
ANTHROPIC_MODEL=              # optional, default claude-sonnet-5-5
OPENAI_API_KEY=               # optional alternative provider
OPENAI_MODEL=                 # optional, default gpt-4o-mini
AI_PROVIDER=                  # optional: anthropic | openai
RESEND_API_KEY=               # optional admin e-mail notifications
ADMIN_NOTIFY_EMAIL=           # where notifications are sent
MAIL_FROM=                    # e.g. ELTEZAM <noreply@your-domain>
MOYASAR_SECRET_KEY=           # reserved for a future Moyasar payment integration (not used yet)
