    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^5.8.8",
    "tailwind-merge": "^3.7.0",
