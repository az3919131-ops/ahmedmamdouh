# انسخ هذا الملف إلى .env.local وعدّل القيم. كل المتغيرات اختيارية (لها قيم افتراضية).
# تنبيه: متغيرات VITE_* تُدمج في ملفات الواجهة العامة — لا تضع هنا أي سر أو مفتاح.
# المفتاح السري للوحة التحكم يُكتب في المتصفح عند الدخول فقط، ولا يوضع هنا أبدًا.

# رقم واتساب بصيغة دولية بلا + (زر التواصل، نموذج واتساب، بطاقة جهة الاتصال)
VITE_WHATSAPP_NUMBER=966565324387

# عنوان خادم n8n بلا شرطة أخيرة (هذه القيمة هي الافتراضي المدمج؛ اتركها فارغة VITE_N8N_BASE_URL= لتعطيله). منه يُشتق: رابط مراجعة الصفحة /webhook/<المعرّف>
# ورابط النموذج /form/<المعرّف> ورابط لوحة التحكم /webhook/<المسار>
VITE_N8N_BASE_URL=https://vmi3330209.contaboserver.net

# معرّف Webhook / نموذج «مراجعة الصفحة والتعليقات» (التبويب الثاني في قسم التواصل)
VITE_N8N_WEBHOOK_ID=0818531a-3892-49f6-af78-cde8d538b205

# مسار webhook لوحة التحكم (workflow «واجهة لوحة التحكم – أحمد»)
VITE_N8N_DASHBOARD_PATH=ahmed-dashboard

# العنوان العام للموقع (يملأ حقل «رابط الصفحة» تلقائيًا). فارغ = عنوان الصفحة الحالية.
VITE_SITE_URL=
