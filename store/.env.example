# انسخ هذا الملف إلى .env للتشغيل المحلي (npm run dev). على Netlify ضع نفس الأسماء في
# Site configuration → Environment variables.
# Project manager · Eng. Ahmed Zahran
#
# ═══════ عامة: تُدمج في ملفات الموقع وقت البناء (آمنة للنشر) ═══════

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API → anon / publishable key  (ليس service_role!)
SUPABASE_ANON_KEY=

# Moyasar → Dashboard → Settings → API Keys → Publishable key (pk_test_… للتجربة، pk_live_… للإنتاج)
MOYASAR_PUBLISHABLE_KEY=
# وسائل الدفع المعروضة في نموذج Moyasar، مفصولة بفواصل. المدعوم هنا: creditcard (مدى/فيزا/ماستركارد) و stcpay
PAYMENT_METHODS=creditcard

# رقم واتساب الدولي بلا + ولا مسافات، وبريد التواصل
WHATSAPP_NUMBER=966565324387
CONTACT_EMAIL=az3919131@gmail.com

# رابط الموقع النهائي (لخريطة الموقع والبيانات الوصفية). اتركه فارغًا ليؤخذ من Netlify تلقائيًا.
SITE_URL=

# بيانات الحوالة البنكية (اختيارية؛ تظهر للعميل عند اختيار «حوالة بنكية»)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=

# ═══════ أسرار الخادم: لدوال Netlify فقط — لا تضعها في ملف عام ولا في الكود ═══════
# في Netlify فعّل خيار Contains secret values على هذه الثلاثة ونطاقها على Functions.

# Supabase → Project Settings → API → service_role key  (يتجاوز RLS — سري جدًا)
SUPABASE_SERVICE_ROLE_KEY=
# Moyasar → Settings → API Keys → Secret key (sk_test_… / sk_live_…)
MOYASAR_SECRET_KEY=
# نص عشوائي طويل تضعه أيضًا كـ secret_token عند تسجيل الـ webhook في Moyasar
MOYASAR_WEBHOOK_SECRET=

# ═══════ اختياري ═══════
# بناء نسخة عرض (Demo) عمدًا بلا Supabase — تُحجب في الإنتاج افتراضيًا كي لا تنشر متجرًا لا يحفظ الطلبات
# ALLOW_DEMO=1
